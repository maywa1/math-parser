cabal-version: 3.0
name: math-parser
version: 0.1.0.0

library
    hs-source-dirs: src
    exposed-modules:
        Calc.Evaluator
        Calc.Error
        Calc.Token
        Calc.Parser
        Calc.Lexer
    build-depends:
        base,
        containers
    ghc-options:
        -Wmissing-home-modules
    default-language: Haskell2010

executable math-parser
    main-is: Main.hs
    hs-source-dirs: app
    build-depends:
        base,
        containers,
        math-parser
    ghc-options:
        -Wmissing-home-modules
    default-language: Haskell2010

test-suite tests
    type: exitcode-stdio-1.0
    main-is: Test.hs
    hs-source-dirs: test
    build-depends:
        base,
        math-parser
    ghc-options:
        -Wmissing-home-modules
    default-language: Haskell2010

