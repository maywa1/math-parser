cabal-version: 3.0
name: math-parser
version: 0.1.0.0

executable math-parser
    main-is: Main.hs
    hs-source-dirs: src
    build-depends:
        base
    default-language: Haskell2010
    other-modules:
        Calculator

test-suite tests
    type: exitcode-stdio-1.0
    main-is: Test.hs
    hs-source-dirs:
        test
        src
    build-depends:
        base
    default-language: Haskell2010
    other-modules:
        Calculator
